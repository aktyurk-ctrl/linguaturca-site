{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run typecheck && npm run lint && npm run build",
  "installCommand": "npx --yes npm@11.21.0 ci --include=dev",
  "outputDirectory": ".next",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "regions": [
    "fra1"
  ],
  "github": {
    "enabled": true,
    "autoJobCancelation": true
  },
  "git": {
    "deploymentEnabled": true
  }
}
